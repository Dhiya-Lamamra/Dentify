# Copie ce fichier en .env pour lancer le backend sans Docker
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dentify
DB_USER=root
DB_PASSWORD=rootpassword
JWT_SECRET=change-moi
# Origines autorisées (site web Vite + app Expo web), séparées par des virgules
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006
